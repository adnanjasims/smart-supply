# turns on the "ask the data" tab. grab a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# only needed if the default model is rate-limited
# GEMINI_MODEL=gemini-2.5-flash

# optional AWS backends (S3 model registry and DynamoDB forecast serving)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=
SMARTSUPPLY_S3_BUCKET=
SMARTSUPPLY_DDB_TABLE=
